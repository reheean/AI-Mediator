          setTimeout(()=>{
            cursorEl.classList.remove('on');
            homeStage.classList.remove('show');
            resultsStage.classList.add('show');
            revealRows(0);
          }, 1100);
        }
      }
      next();
    }

    function revealRows(idx){
      if (idx >= resultIds.length){
        setTimeout(()=>{
          document.getElementById('r-target').classList.add('highlight');
        }, 900);
        setTimeout(()=>{
          continueWrap.classList.add('show');
          setTimeout(()=>continueBtn.classList.add('pulse'), 700);
